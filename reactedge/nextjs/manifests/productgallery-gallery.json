    "css": ".reactedge-productgallery .product-gallery__zoom{text-align:center;width:100%;height:100%;position:relative}.reactedge-productgallery .product-gallery__zoom-image{object-fit:contain;border-radius:12px;width:100%;height:auto;max-height:85vh;transition:opacity .3s}.reactedge-productgallery .product-gallery__zoom-arrow{z-index:1;cursor:pointer;color:#555;opacity:.7;-webkit-user-select:none;user-select:none;background:0 0;border:0;border-radius:8px;padding:10px;font-size:40px;position:absolute;top:50%;transform:translateY(-50%)}.reactedge-productgallery .product-gallery__zoom-arrow--previous{left:20px}.reactedge-productgallery .product-gallery__zoom-arrow--next{right:20px}.reactedge-productgallery .product-gallery__zoom-minify{z-index:1;color:#fff;cursor:pointer;opacity:.8;background:#000;border:0;border-radius:6px;padding:6px 12px;font-size:14px;position:absolute;top:20px;right:20px}.reactedge-productgallery .product-gallery__zoom-arrow:hover,.reactedge-productgallery .product-gallery__zoom-minify:hover{opacity:1}.reactedge-productgallery .product-gallery__zoom-arrow:focus-visible,.reactedge-productgallery .product-gallery__zoom-minify:focus-visible{outline-offset:2px;outline:2px solid #555}.reactedge-productgallery .product-gallery__slider{text-align:center;padding:20px;position:relative}.reactedge-productgallery .product-gallery__slider-main-image{object-fit:contain;border-radius:12px;width:100%;height:auto;max-height:75vh;transition:opacity .3s;box-shadow:0 2px 12px #00000014}.reactedge-productgallery .product-gallery__slider-thumbnails{flex-wrap:wrap;justify-content:center;gap:12px;margin-top:20px;display:flex;position:relative}.reactedge-productgallery .product-gallery__slider-thumbnail{cursor:pointer;opacity:.7;background:0 0;border:2px solid #e0e0e0;border-radius:8px;padding:0;transition:opacity .2s,transform .2s}.reactedge-productgallery .product-gallery__slider-thumbnail img{object-fit:cover;border-radius:6px;width:140px;height:140px;display:block}.reactedge-productgallery .product-gallery__slider-thumbnail--active{opacity:1;border-color:#555;transform:scale(1.02)}.reactedge-productgallery .product-gallery__slider-arrow{z-index:1;cursor:pointer;color:#555;opacity:.7;-webkit-user-select:none;user-select:none;background:0 0;border:0;border-radius:8px;padding:10px;font-size:40px;position:absolute;top:50%;transform:translateY(-50%)}.reactedge-productgallery .product-gallery__slider-arrow--previous{left:20px}.reactedge-productgallery .product-gallery__slider-arrow--next{right:20px}.reactedge-productgallery .product-gallery__slider-main{position:relative}@media (width<=600px){.reactedge-productgallery .product-gallery__slider-thumbnail img{width:90px;height:90px}}.reactedge-productgallery .product-gallery__tile-grid{grid-template-columns:repeat(var(--gallery-max-columns), minmax(0, 1fr));gap:16px;display:grid}.reactedge-productgallery .product-gallery__tile{cursor:pointer;opacity:1;background:0 0;border:0;border-radius:12px;padding:0;transition:opacity .4s,transform .2s;display:block;overflow:hidden;transform:translateY(0);box-shadow:0 2px 12px #00000014}.reactedge-productgallery .product-gallery__tile:hover{transform:scale(1.02)}.reactedge-productgallery .product-gallery__tile:focus-visible{outline-offset:2px;outline:2px solid}.reactedge-productgallery .product-gallery__tile-image{width:100%;height:auto;display:block}@media (width<=600px){.reactedge-productgallery .product-gallery__tile-grid{grid-template-columns:1fr}}.reactedge-productgallery .product-gallery__dummy,.reactedge-productgallery .standard-widget-loader-wrapper{z-index:1;justify-content:center;align-items:center;display:flex;position:absolute;inset:0}\n/*$vite$:1*/",
